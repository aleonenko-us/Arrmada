# Build artifacts & local runtime — never send to the build context.
/arrmada
/arrmada.exe
/bin/
/dist/
/data/
# install.sh's default Convert scratch folder and update.sh's download staging.
/transcode/
# A media folder kept next to the install (relative ARRMADA_MEDIA_HOST values are refused,
# but a full path can still point here): never part of a build.
/media/
.arrmada-download.*
*.db
*.db-shm
*.db-wal
*.log

# Frontend — deps and build output are regenerated inside the image.
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# Dev tooling & docs not needed for the build.
.git/
.github/
.claude/
.gitignore
.idea/
.vscode/
*.md
# ...except the licence notices, which ship in the image (internal/audiotag links LGPL code).
!THIRD_PARTY_NOTICES.md
