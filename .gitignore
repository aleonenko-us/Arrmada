# Build output
/arrmada
/arrmada.exe
/dist/
/bin/

# Go
/vendor/
*.test
*.out

# Embedded UI build output (generated by the web build)
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Node / frontend
/web/node_modules/
/web/dist/
/web/bundle-stats.html
*.local

# Runtime data (config, db, logs, backups)
/data/
*.db
*.db-shm
*.db-wal
*.log

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local secrets (TMDB key, etc.)
.env

# User-specific compose override (existing-library mounts)
docker-compose.override.yml

# update.sh / install.sh: .env as it was before they changed a line in it
.env.bak-*
# update.sh: the commit that was checked out before the last pull
.arrmada-previous
# update.sh: the database backup taken before the last update (for --rollback --with-db)
.arrmada-previous-db
# install.sh: Convert's default scratch folder, the downloaded-install marker, and
# update.sh's download staging and override backup
/transcode/
.arrmada-source
.arrmada-download.*
docker-compose.override.yml.bak

# Playwright (web/e2e) run output
/web/test-results/
/web/playwright-report/
/web/blob-report/

# local dev
/bin/
/.dev-data/
/.dev-data.log
